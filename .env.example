# Copy this file to .env and fill in your keys.
#
#   cp .env.example .env
#
# .env is gitignored and must never be committed. If a key ever lands in a
# commit, a chat log, or a screenshot, rotate it rather than hoping nobody saw.

# https://openrouter.ai/keys
OPENROUTER_API_KEY=

# https://dashboard.sarvam.ai (free tier: ~100 INR credits, about 3.3 audio hours)
SARVAM_API_KEY=
